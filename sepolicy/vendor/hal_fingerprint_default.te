typeattribute hal_fingerprint_default data_between_core_and_vendor_violators;

allow hal_fingerprint_default { egis_finger_device uhid_device }:chr_file rw_file_perms;
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;

binder_call(hal_fingerprint_default, hal_fingerprint_default)

r_dir_file(hal_fingerprint_default, vendor_proc_fingerprint)
rw_dir_file(hal_fingerprint_default, fingerprintd_data_file)
rw_dir_file(hal_fingerprint_default, vendor_sysfs_fingerprint)

set_prop(hal_fingerprint_default, vendor_fingerprint_prop)
