hal_client_domain(hal_camera_default, hal_algodaemon)

allow hal_camera_default mnt_vendor_file:dir search;
allow hal_camera_default mnt_vendor_file:file { read write };
allow hal_camera_default oppoalgo_service:service_manager find;
allow hal_camera_default oppo_fingerprint_file:dir rw_dir_perms;
allow hal_camera_default oppo_fingerprint_file:file rw_file_perms;
allow hal_camera_default persist_camera_file:dir create_dir_perms;
allow hal_camera_default persist_camera_file:file create_file_perms;
allow hal_camera_default proc:file rw_file_perms;
allow hal_camera_default sysfs:file { open read };

r_dir_file(hal_camera_default, oppo_version_proc)
r_dir_file(hal_camera_default, proc_devinfo_file)
get_prop(hal_camera_default, oppo_version_prop)
set_prop(hal_camera_default, oppo_camera_prop)
