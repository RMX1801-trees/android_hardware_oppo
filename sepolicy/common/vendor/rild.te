typeattribute rild data_between_core_and_vendor_violators;

allow rild block_device:dir search;
allow rild cache_file:dir create_dir_perms;
allow rild cache_file:file create_file_perms;
allow rild nv_data_file:dir create_dir_perms;
allow rild nv_data_file:file create_file_perms;
allow rild oppo_reserve_file:dir rw_dir_perms;
allow rild oppo_reserve_file:file rw_file_perms;

r_dir_file(rild, proc_devinfo_file)
get_prop(rild, oppo_version_prop)
set_prop(rild, oppo_network_prop)
